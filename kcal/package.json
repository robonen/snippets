{
  "name": "kcal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Локальный дневник питания: калории, БЖУ, вес. Vue Vapor + @sync (local-first CRDT) + IndexedDB, без бэкенда.",
  "scripts": {
    "dev": "vite",
    "generate-pwa-assets": "pwa-assets-generator",
    "build": "vite build && node scripts/copy-pwa.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@robonen/platform": "^0.0.5",
    "@robonen/stdlib": "^0.0.12",
    "@robonen/vue": "^0.2.0",
    "@sync/core": "link:../sync-crdt/packages/core",
    "@sync/fiber": "link:../sync-crdt/packages/fiber",
    "@sync/vue": "link:../sync-crdt/packages/vue",
    "barcode-detector": "^3.2.2",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide": "^1.33.0",
    "nitro": "3.0.260610-beta",
    "vue": "3.6.0-rc.5",
    "zxing-wasm": "3.1.1"
  },
  "devDependencies": {
    "@robonen/eslint": "^0.0.1",
    "@robonen/tsconfig": "^0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "eslint": "^10.9.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-jsx-vapor": "^3.2.21"
  }
}
